# Copy to backup.env (git-ignored). Never commit real values.
# Source database (use a read-only role with pg_dump rights)
BACKUP_DATABASE_URL=postgresql://backup_ro:CHANGE_ME@db-host:5432/orion_db?sslmode=require
# Where dumps are kept locally before upload
BACKUP_DIR=./backups
# Off-site copy (S3-compatible: R2 / S3 / MinIO). Leave BACKUP_S3_BUCKET empty to skip.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# Encryption: path to a file holding a passphrase (chmod 600). Empty = unencrypted (not for production).
BACKUP_PASSPHRASE_FILE=
# Retention (grandfather-father-son)
RETAIN_DAILY=7
RETAIN_WEEKLY=4
RETAIN_MONTHLY=12
# Deletion ledger copies kept (digests and ids only; each run writes a full ledger, the newest one is the one to re-apply)
RETAIN_LEDGER=30
# Set to true ONLY where Node and the repository are not available; the backup then cannot re-apply later deletions after a restore
BACKUP_SKIP_LEDGER=false
# Optional: URL pinged on success / failure (healthchecks.io style)
BACKUP_PING_OK_URL=
BACKUP_PING_FAIL_URL=
