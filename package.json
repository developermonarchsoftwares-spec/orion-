{
  "name": "orion-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run start:api\" \"npm run start:web\"",
    "dev:api": "npm run start:api",
    "dev:web": "npm run start:web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:qa": "npm run test:e2e:all --prefix apps/api && npm run test --prefix ownus",
    "start:api": "npm --prefix apps/api run start:dev",
    "start:web": "npm --prefix ownus run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
