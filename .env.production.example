# ==============================================================================
# ORION ENTERPRISE PLATFORM — COMPLETE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Orion Lead Intelligence Platform
APP_URL=https://orion-api-snowy.vercel.app
CORS_ORIGINS=https://orion-api-snowy.vercel.app,http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT (NEXT.JS PUBLIC VARIABLES)
# ------------------------------------------------------------------------------
# Public URL of the backend API used by the browser client
NEXT_PUBLIC_API_URL=https://orion-api-snowy.vercel.app/api/v1
# Public website base URL
NEXT_PUBLIC_APP_URL=https://orion-api-snowy.vercel.app
# Upstream API URL for Vercel serverless proxy route
BACKEND_API_URL=https://orion-api-snowy.vercel.app/api/v1

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & DRIZZLE ORM)
# Compatible with Neon, Supabase, AWS RDS, or self-hosted PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/orion_db?sslmode=require
DB_HOST=ep-cool-sample.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=orion_db
DB_SSL=true
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000



# ------------------------------------------------------------------------------
# 5. HIGH-PERFORMANCE SEARCH ENGINE (TYPESENSE)
# Powers sub-50ms search and multi-facet filtering across 1.2M+ business records
# Compatible with Typesense Cloud or self-hosted Typesense cluster
# ------------------------------------------------------------------------------
TYPESENSE_NODES=xxx.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_search_admin_api_key
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION & SECURITY TOKENS
# Used to sign session tokens for Orion subscribers and corporate admins
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=generate_a_secure_64_char_random_string_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_secure_64_char_random_string_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=orion-api
JWT_AUDIENCE=orion-client

# ------------------------------------------------------------------------------
# 7. S3-COMPATIBLE OBJECT STORAGE
# Stores uploaded CSV/Excel import batches, data exports, and business assets
# Compatible with Cloudflare R2, AWS S3, or MinIO
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=orion-production-assets
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_cloudflare_r2_or_s3_access_key
STORAGE_SECRET_KEY=your_cloudflare_r2_or_s3_secret_key
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL_PREFIX=https://assets.yourdomain.com

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (RAZORPAY)
# Powers platform wallet credit purchases, package top-ups, and auto-invoicing
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# ------------------------------------------------------------------------------
# 9. SINGLE SIGN-ON (OAUTH 2.0 PROVIDERS)
# Enables 1-click login with Google and Microsoft Azure AD
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://orion-api-snowy.vercel.app/api/v1/auth/google/callback

# Microsoft Azure Portal -> Azure Active Directory -> App Registrations
MICROSOFT_CLIENT_ID=your-azure-ad-application-client-id
MICROSOFT_CLIENT_SECRET=your-azure-ad-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=https://orion-api-snowy.vercel.app/api/v1/auth/microsoft/callback

# ------------------------------------------------------------------------------
# 10. TRANSACTIONAL EMAIL & REAL OTP DISPATCH
# Required to send real 6-digit OTP codes and welcome emails to user inboxes
# Compatible with Resend, SendGrid, Postmark, Amazon SES, or custom SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM="Monarch Security" <security@monarchsoftwares.com>
# Or direct API Key if using Resend SDK:
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 11. RATE LIMITING & SECURITY GUARDS
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100