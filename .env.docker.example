# Variables required by docker-compose.yml. Copy to ".env" (git-ignored) and give every entry a value generated for YOUR environment.
# Never reuse a value from this repository's history, and never use a production credential here.
# The stack refuses to start while any of these is unset or empty.
#
#   openssl rand -base64 48        # JWT secrets, Typesense key
#   openssl rand -hex 24           # database / storage passwords (hex keeps the database URL valid)

POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
TYPESENSE_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
